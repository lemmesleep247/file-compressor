# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# MinIO connection
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_USE_SSL=false

# Shared secret the /minio-event webhook must receive, either as the
# X-Webhook-Token header or as Authorization: Bearer <token> (what MinIO
# sends when you set auth_token on the notify_webhook target). Leave empty
# to disable auth (not recommended outside local dev).
WEBHOOK_TOKEN=

# Image compression
ENABLE_WEBP=false
MIN_IMAGE_SIZE_KB=100

# Skip files larger than this to bound memory usage (whole file is
# loaded into memory for compression).
MAX_FILE_SIZE_MB=200

# Generic (non-image) compression
ENABLE_GENERIC_COMPRESSION=true
GENERIC_COMPRESSION=zstd
ZSTD_LEVEL=3

# Worker pool / retry
WORKER_COUNT=5
MAX_RETRIES=3

# Dead-letter bucket for jobs that exhaust their retries
DLQ_BUCKET=image-dead-letter

# Path to the SQLite job-queue database file
DB_PATH=jobs.db

# Directory for day-wise log files (logs/YYYY-MM-DD.log) and how long to
# keep them before the background cleanup scheduler deletes them.
LOG_DIR=logs
LOG_RETENTION_DAYS=30

# Port to listen on
PORT=8090
