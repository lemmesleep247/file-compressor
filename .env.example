# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# MinIO connection
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_USE_SSL=false

# Shared secret the /minio-event webhook must receive, either as the
# X-Webhook-Token header or as Authorization: Bearer <token> (what MinIO
# sends when you set auth_token on the notify_webhook target). Leave empty
# to disable auth (not recommended outside local dev).
WEBHOOK_TOKEN=

# Only process events from these buckets (comma-separated). Empty = every
# bucket except DLQ_BUCKET.
ALLOWED_BUCKETS=

# Basic-auth password for the dashboard and /api/* (any username). Both
# tokens are required unless ALLOW_INSECURE=true.
DASHBOARD_TOKEN=

# Local development only: allow starting with the tokens above unset,
# which leaves the webhook and dashboard open to anyone who can reach them.
ALLOW_INSECURE=false

# Non-destructive mode: write compressed results to this bucket (same key)
# and never modify the source object. Empty = compress in place (images
# replace the original; generic files get a .zst sibling). Must not be in
# ALLOWED_BUCKETS or equal DLQ_BUCKET; it is created if missing.
OUTPUT_BUCKET=

# Image compression
ENABLE_WEBP=false
# JPEG/WebP quality, 1-100.
IMAGE_QUALITY=75
# Downscale images whose longer side exceeds this many pixels (0 = never).
# Usually the biggest saving; JPEG EXIF rotation is baked into the pixels.
MAX_IMAGE_DIMENSION=0
# Per-bucket overrides of the three settings above, as JSON keyed by bucket.
# Unset fields use the global values. Example:
# BUCKET_RULES={"photos":{"image_quality":60,"max_dimension":2048,"webp":true}}
BUCKET_RULES=
MIN_IMAGE_SIZE_KB=100

# Skip images that decode to more than this many megapixels
# (decompression-bomb guard). 0 disables the check.
MAX_IMAGE_MEGAPIXELS=100

# Max seconds one job may spend downloading/compressing/uploading.
JOB_TIMEOUT_SECONDS=300

# Skip files larger than this to bound memory usage (whole file is
# loaded into memory for compression).
MAX_FILE_SIZE_MB=200

# Generic (non-image) compression. Writes <key>.zst NEXT TO the original
# (the original is left untouched); .zst objects are never reprocessed.
ENABLE_GENERIC_COMPRESSION=true
GENERIC_COMPRESSION=zstd
ZSTD_LEVEL=3

# Worker pool / retry
WORKER_COUNT=5
MAX_RETRIES=3

# Dead-letter bucket for jobs that exhaust their retries
DLQ_BUCKET=image-dead-letter

# Path to the SQLite job-queue database file
DB_PATH=jobs.db

# Delete completed / dead-letter job rows older than this many days
# (0 = keep forever). Dashboard totals cover the retained rows.
JOB_RETENTION_DAYS=90

# Log verbosity: debug | info | warn | error. debug adds per-job steps and
# the reason every object is skipped. Can also be changed while running:
#   curl -u x:$DASHBOARD_TOKEN -X POST -H 'X-Requested-With: curl' \
#     'http://localhost:8090/api/loglevel?level=debug'
LOG_LEVEL=info

# Console encoding: json | text (text is easier to read in a terminal).
# The log files are always JSON.
LOG_FORMAT=json

# Directory for day-wise log files (logs/YYYY-MM-DD.log) and how long to
# keep them before the background cleanup scheduler deletes them.
LOG_DIR=logs
LOG_RETENTION_DAYS=30

# Port to listen on
PORT=8090
